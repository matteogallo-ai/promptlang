{
  "name": "@promptlang/core",
  "version": "2.0.0",
  "description": "The typed language for production-grade LLM prompts",
  "workspaces": [
    "packages/*"
  ],
  "author": "Matteo Gallo <matteo.gallo@gallarti.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matteogallo-ai/promptlang.git"
  },
  "homepage": "https://github.com/matteogallo-ai/promptlang",
  "bugs": "https://github.com/matteogallo-ai/promptlang/issues",
  "keywords": [
    "prompt-engineering",
    "llm",
    "dsl",
    "compiler",
    "ai",
    "openai",
    "anthropic",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "promptlang": "dist/cli/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p packages/yaml-parser",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "check:claims": "bun run scripts/check-claims.ts",
    "check:stale-narrative": "bun run scripts/check-stale-narrative.ts",
    "check:commits": "bun run scripts/check-commits.ts",
    "cli": "bun run src/cli/cli.ts",
    "bench": "bun run benchmarks/bench.ts",
    "demo": "bun run scripts/demo.ts",
    "build": "bun run scripts/build.ts",
    "prepack": "bun run scripts/build.ts",
    "test:consumer": "bun run scripts/consumer-test.ts"
  },
  "devDependencies": {
    "@promptlang/yaml-parser": "workspace:*",
    "@biomejs/biome": "2.6.4",
    "@types/bun": "latest",
    "knip": "6.44.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.20"
  },
  "publishConfig": {
    "access": "public"
  }
}
