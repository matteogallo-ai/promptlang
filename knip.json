{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/index.ts", "src/runtime/index.ts", "src/cli/cli.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "packages/yaml-parser": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
