{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@promptlang/core": ["./src/index.ts"],
      "@promptlang/core/runtime": ["./src/runtime/index.ts"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "lib": ["ESNext"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "benchmarks/**/*"]
}
