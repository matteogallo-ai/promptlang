{
  "name": "promptlang",
  "version": "1.2.0",
  "description": "The typed language for production-grade LLM prompts",
  "workspaces": [
    "packages/*"
  ],
  "author": "Matteo Gallo <matteo.gallo@gallarti.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matteogallo-ai/promptlang.git"
  },
  "homepage": "https://github.com/matteogallo-ai/promptlang",
  "bugs": "https://github.com/matteogallo-ai/promptlang/issues",
  "keywords": [
    "prompt-engineering",
    "llm",
    "dsl",
    "compiler",
    "ai",
    "openai",
    "anthropic",
    "typescript"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "bin": {
    "promptlang": "./src/cli/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p packages/yaml-parser",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "cli": "bun run src/cli/cli.ts"
  },
  "dependencies": {
    "@promptlang/yaml-parser": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "latest",
    "knip": "6.44.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
